{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "(?<depName>Haraka|haraka-plugin-wildduck)@(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
